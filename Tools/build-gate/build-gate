#!/bin/bash
# build-gate: the only command the Linux build agent may run on the Mac.
#
# Installed as a forced command in ~/.ssh/authorized_keys of a dedicated, non-admin macOS user.
# Whatever the client asks for arrives in $SSH_ORIGINAL_COMMAND; anything that is not one of the
# verbs below is refused. It never opens a shell. Since v2 it can run the app's UI tests in the
# iOS Simulator and hand back their artifacts (screenshots, logs); it still touches nothing
# outside its own home directory.
#
# Verbs:
#   build <ref>   fetch, check out <ref> (branch name or commit sha), compile for the iOS Simulator
#                 with signing off, print the errors/warnings and the result line
#   ipa <ref>     same checkout, Release build for devices with signing off, packed as an unsigned
#                 .ipa into /Users/Shared/Paseo-ipas/ (readable by the owner's own account)
#   ping          print the gate version, the Xcode and macOS versions
#   sims          list the installed simulator runtimes and available iPhone simulators
#   uitest <ref> [filter]
#                 same checkout, build and run the `PaseoUITests` scheme in an iPhone simulator.
#                 `filter` narrows to a class or a class/method (`ChatFlowTests/testRewind`).
#                 Prints one line per test, the failures, and the list of artifacts kept under
#                 ~/sim-artifacts/<run>/ (newest 5 runs kept): exported attachments
#                 (screenshots, accessibility dumps, wire logs the tests attach) and app.log.
#   ls [run]      list the runs, or one run's files
#   get <path>    write one artifact (path as printed by uitest/ls) to stdout
#   simreset      erase the test simulator (a clean install on the next run)
#
# v3: drive the app in the simulator and read what happened (all simulator-only, never a device):
#   test <ref> <scheme> <Target[/Class[/method]]>
#                 like uitest for any allowed scheme (PaseoUITests, PaseoClient, PaseoUI, PaseoCore)
#   analyze <ref> Xcode static analyzer over the app scheme; prints the findings
#   regen <ref>   run xcodegen on App/project.yml; writes the resulting diff of App/ as a patch
#                 artifact (the repo checkout is reset; apply the patch and commit it yourself)
#   install <ref> build the Debug app for the simulator and install it on the test simulator
#   launch <args|-> start the installed app with launch arguments (comma-separated, or "-" for
#                 none); prints its pid
#   terminate     stop the app
#   shot [name]   screenshot of the simulator into the artifacts (fetch with `get`)
#   openurl <url> open a paseo:// URL in the simulator (nothing else is accepted)
#   appearance light|dark
#   textsize <category>   Dynamic Type: xs s m l xl xxl xxxl ax1 ax2 ax3 ax4 ax5
#   statusbar on|off      fixed 9:41 status bar for comparable screenshots
#   privacy <grant|revoke|reset> <service>   photos camera microphone location contacts calendar
#   crashes [n]   newest n (max 3) Paseo crash reports from this Mac, trimmed
#   status        disk, memory use of this user's processes, simulator state, installed app, lock holder, last gate log lines
#   kill <pid>    stop one process, only if it belongs to this user AND is a build/simulator tool
#                 (xcodebuild, swift-*, clang, ld, Xcode build services, simulator processes,
#                 xctest, the Paseo app); anything else is refused. TERM first, KILL after 3 s.
#   killbuilds    the same for every such process of this user except the running gate job
#   clean         delete derived data and artifacts under the claude home (nothing else)
#
# Safety model: forced command, fixed verbs, every argument matched against a strict pattern,
# no argument ever reaches a shell, one job at a time (lock), hard time limits, simulator only
# (no device, no signing identity, no keychain access), reads limited to the artifacts folder,
# the repo checkout and this user's own Paseo crash reports.
#
# Optional ~/paseo-sim.env on the Mac (never in the repo), `KEY=value` lines:
#   PASEO_*=...       passed to the tests as environment (e.g. PASEO_TEST_HOST=host:port)
#   SIM_NAME=...      simulator device name (default: the first available iPhone)
#   SIM_SIGN=none     build the tests with signing off instead of ad-hoc ("-")
set -euo pipefail

REPO="$HOME/Paseo-client"
DERIVED="$HOME/build-derived-data"
LOG="$HOME/build-gate.log"
# Hard cap on one build so a hang never ties up the Mac.
MAX_SECONDS=1500
GATE_VERSION=3
ART="$HOME/sim-artifacts"
SIM_ENV="$HOME/paseo-sim.env"
UITEST_MAX_SECONDS=2700

read -r verb ref arg2 arg3 extra <<<"${SSH_ORIGINAL_COMMAND:-}"

nargs=0
for a in "${ref:-}" "${arg2:-}" "${arg3:-}" "${extra:-}"; do [[ -n "$a" ]] && nargs=$((nargs + 1)); done
case "${verb:-}" in
    ping|sims|simreset|terminate|status|clean|killbuilds) maxargs=0 ;;
    build|ipa|analyze|regen|install|launch|ls|get|shot|openurl|appearance|textsize|statusbar|crashes|kill) maxargs=1 ;;
    uitest|privacy) maxargs=2 ;;
    test) maxargs=3 ;;
    *) maxargs=0 ;;
esac
if (( nargs > maxargs )); then
    echo "refused: too many arguments" >&2
    exit 2
fi
BUNDLE_ID="com.wiselfx.paseoclient"

# One job at a time. A lock directory holds the pid; a dead pid's lock is taken over.
LOCKDIR="$HOME/.gate.lock"
acquire_lock() {
    local tries=0
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        local holder
        holder="$(cat "$LOCKDIR/pid" 2>/dev/null || true)"
        if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$LOCKDIR"
            continue
        fi
        tries=$((tries + 1))
        if (( tries > 60 )); then
            echo "refused: another job is running (pid ${holder:-?}); try again in a few minutes" >&2
            exit 3
        fi
        sleep 5
    done
    echo $$ >"$LOCKDIR/pid"
    trap 'rm -rf "$LOCKDIR"' EXIT
}
case "${verb:-}" in
    build|ipa|uitest|test|analyze|regen|install) acquire_lock ;;
esac

# The booted test simulator or a clear refusal.
require_sim() {
    udid="$(pick_sim || true)"
    if [[ -z "$udid" ]]; then
        echo "refused: no iPhone simulator available" >&2
        exit 2
    fi
    xcrun simctl boot "$udid" >/dev/null 2>&1 || true
    xcrun simctl bootstatus "$udid" >/dev/null 2>&1 || true
}

# One value from ~/paseo-sim.env (empty when absent). Values are taken literally, never evaluated.
sim_env() {
    [[ -f "$SIM_ENV" ]] || return 0
    grep -E "^$1=" "$SIM_ENV" | tail -1 | cut -d= -f2- || true
}

# The UDID of the test simulator: SIM_NAME from the env file, else the first available iPhone.
pick_sim() {
    local name
    name="$(sim_env SIM_NAME)"
    if [[ -n "$name" ]]; then
        xcrun simctl list devices available | grep -F "    $name (" | head -1 \
            | grep -oE '[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}' | head -1
    else
        xcrun simctl list devices available | grep -E '^    iPhone' | head -1 \
            | grep -oE '[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}' | head -1
    fi
}

# Fetch and check out $1 (a validated ref), detached and clean.
checkout_ref() {
    local r="$1" target
    if [[ ! "$r" =~ ^[A-Za-z0-9._/-]{1,100}$ ]] || [[ "$r" == *..* ]] || [[ "$r" == -* ]]; then
        echo "refused: bad ref" >&2
        exit 2
    fi
    cd "$REPO"
    git fetch --quiet --prune origin
    if git rev-parse --verify --quiet "origin/$r^{commit}" >/dev/null; then
        target="origin/$r"
    elif git rev-parse --verify --quiet "$r^{commit}" >/dev/null; then
        target="$r"
    else
        echo "refused: unknown ref $r" >&2
        exit 2
    fi
    git checkout --quiet --force --detach "$target"
    git clean -fdq
}

case "${verb:-}" in
ping)
    echo "gate v$GATE_VERSION"
    xcodebuild -version
    sw_vers -productVersion
    ;;
build)
    # Branch names and shas only: letters, digits, dot, dash, underscore, slash.
    if [[ ! "${ref:-}" =~ ^[A-Za-z0-9._/-]{1,100}$ ]] || [[ "$ref" == *..* ]] || [[ "$ref" == -* ]]; then
        echo "refused: bad ref" >&2
        exit 2
    fi
    cd "$REPO"
    git fetch --quiet --prune origin
    if git rev-parse --verify --quiet "origin/$ref^{commit}" >/dev/null; then
        target="origin/$ref"
    elif git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
        target="$ref"
    else
        echo "refused: unknown ref $ref" >&2
        exit 2
    fi
    git checkout --quiet --force --detach "$target"
    git clean -fdq
    echo "commit $(git rev-parse --short HEAD)"

    out="$(mktemp)"
    trap 'rm -f "$out"' EXIT
    set +e
    # perl alarm = a portable timeout on macOS (no coreutils `timeout`).
    perl -e 'alarm shift; exec @ARGV' "$MAX_SECONDS" \
        xcodebuild -project App/PaseoClient.xcodeproj -scheme PaseoClient \
        -configuration Debug -destination 'generic/platform=iOS Simulator' \
        -derivedDataPath "$DERIVED" \
        -skipPackagePluginValidation -skipMacroValidation \
        CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
        build >"$out" 2>&1
    status=$?
    set -e
    echo "$(date -u +%FT%TZ) build $ref status=$status" >>"$LOG"

    # Only diagnostics, de-duplicated, with paths made repo-relative.
    grep -E '(error|warning): ' "$out" | sed "s#$REPO/##g" | sort -u | head -300 || true
    if [[ $status -eq 142 ]]; then
        echo "BUILD TIMED OUT after ${MAX_SECONDS}s"
    elif [[ $status -ne 0 ]] && ! grep -qE 'error: ' "$out"; then
        # A failure without a compiler diagnostic: show the tail so it can be diagnosed.
        tail -40 "$out" | sed "s#$REPO/##g"
    fi
    grep -E '\*\* BUILD (SUCCEEDED|FAILED) \*\*' "$out" || echo "BUILD exit $status"
    exit "$status"
    ;;
ipa)
    if [[ ! "${ref:-}" =~ ^[A-Za-z0-9._/-]{1,100}$ ]] || [[ "$ref" == *..* ]] || [[ "$ref" == -* ]]; then
        echo "refused: bad ref" >&2
        exit 2
    fi
    cd "$REPO"
    git fetch --quiet --prune origin
    if git rev-parse --verify --quiet "origin/$ref^{commit}" >/dev/null; then
        target="origin/$ref"
    elif git rev-parse --verify --quiet "$ref^{commit}" >/dev/null; then
        target="$ref"
    else
        echo "refused: unknown ref $ref" >&2
        exit 2
    fi
    git checkout --quiet --force --detach "$target"
    git clean -fdq
    sha="$(git rev-parse --short HEAD)"
    out="$(mktemp)"
    stage="$(mktemp -d)"
    trap 'rm -rf "$out" "$stage"' EXIT
    set +e
    perl -e 'alarm shift; exec @ARGV' "$MAX_SECONDS" \
        xcodebuild -project App/PaseoClient.xcodeproj -scheme PaseoClient \
        -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' \
        -derivedDataPath "$HOME/build-derived-data-device" \
        -skipPackagePluginValidation -skipMacroValidation \
        CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
        build >"$out" 2>&1
    status=$?
    set -e
    echo "$(date -u +%FT%TZ) ipa $ref status=$status" >>"$LOG"
    if [[ $status -ne 0 ]]; then
        grep -E 'error: ' "$out" | sed "s#$REPO/##g" | sort -u | head -100 || true
        echo "IPA FAILED (exit $status)"
        exit "$status"
    fi
    app="$(find "$HOME/build-derived-data-device/Build/Products/Release-iphoneos" -maxdepth 1 -name '*.app' | head -1)"
    mkdir -p "$stage/Payload" /Users/Shared/Paseo-ipas
    cp -R "$app" "$stage/Payload/"
    name="Paseo-$(date +%Y%m%d-%H%M)-$sha.ipa"
    (cd "$stage" && zip -qry "$name" Payload)
    mv "$stage/$name" "/Users/Shared/Paseo-ipas/$name"
    chmod 644 "/Users/Shared/Paseo-ipas/$name"
    # Keep the newest five.
    ls -1t /Users/Shared/Paseo-ipas/*.ipa 2>/dev/null | tail -n +6 | while read -r old; do rm -f "$old"; done
    echo "IPA /Users/Shared/Paseo-ipas/$name"
    ;;
sims)
    xcrun simctl list runtimes | grep -i ios || echo "no iOS simulator runtime installed"
    xcrun simctl list devices available | grep -E '^    iPhone' || echo "no iPhone simulator available"
    echo "selected: $(pick_sim || true)"
    ;;
simreset)
    udid="$(pick_sim || true)"
    if [[ -z "$udid" ]]; then echo "no simulator" >&2; exit 2; fi
    xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
    xcrun simctl erase "$udid"
    echo "erased $udid"
    ;;
uitest|test)
    if [[ "$verb" == "uitest" ]]; then
        scheme="PaseoUITests"
        filter="${arg2:-}"
        if [[ -n "$filter" ]]; then only_arg="PaseoUITests/$filter"; else only_arg=""; fi
    else
        scheme="${arg2:-}"
        filter="${arg3:-}"
        case "$scheme" in
            PaseoUITests|PaseoClient|PaseoUI|PaseoCore) ;;
            *) echo "refused: scheme must be PaseoUITests, PaseoClient, PaseoUI or PaseoCore" >&2; exit 2 ;;
        esac
        only_arg="$filter"
    fi
    if [[ -n "$only_arg" ]] && [[ ! "$only_arg" =~ ^[A-Za-z0-9_]{1,80}(/[A-Za-z0-9_]{1,80}){0,2}$ ]]; then
        echo "refused: bad filter" >&2
        exit 2
    fi
    checkout_ref "${ref:-}"
    sha="$(git rev-parse --short HEAD)"
    echo "commit $sha"
    udid="$(pick_sim || true)"
    if [[ -z "$udid" ]]; then
        echo "refused: no iPhone simulator available (install an iOS runtime in Xcode)" >&2
        exit 2
    fi
    xcrun simctl boot "$udid" >/dev/null 2>&1 || true
    xcrun simctl bootstatus "$udid" >/dev/null 2>&1 || true

    run="$(date +%Y%m%d-%H%M%S)-$sha"
    mkdir -p "$ART/$run"
    out="$ART/$run/xcodebuild.log"

    # PASEO_* lines reach the test process as environment (xcodebuild strips TEST_RUNNER_).
    if [[ -f "$SIM_ENV" ]]; then
        while IFS= read -r line; do
            key="${line%%=*}"
            if [[ "$key" =~ ^PASEO_[A-Z0-9_]{1,60}$ ]]; then
                export "TEST_RUNNER_$key=${line#*=}"
            fi
        done <"$SIM_ENV"
    fi
    export TEST_RUNNER_PASEO_TEST_COMMIT="$sha"

    sign=(CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=NO)
    if [[ "$(sim_env SIM_SIGN)" == "none" ]]; then
        sign=(CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=)
    fi
    only=()
    if [[ -n "$only_arg" ]]; then only=("-only-testing:$only_arg"); fi

    started="$(date +%s)"
    set +e
    perl -e 'alarm shift; exec @ARGV' "$UITEST_MAX_SECONDS" \
        xcodebuild -project App/PaseoClient.xcodeproj -scheme "$scheme" \
        -configuration Debug -destination "platform=iOS Simulator,id=$udid" \
        -derivedDataPath "$DERIVED" -resultBundlePath "$ART/$run/result.xcresult" \
        -skipPackagePluginValidation -skipMacroValidation \
        -parallel-testing-enabled NO \
        "${sign[@]}" ${only[@]+"${only[@]}"} \
        test >"$out" 2>&1
    status=$?
    set -e
    echo "$(date -u +%FT%TZ) $verb $ref ${arg2:-} ${arg3:-} status=$status" >>"$LOG"

    # The app's own log for the length of the run.
    minutes=$(( ( $(date +%s) - started ) / 60 + 1 ))
    xcrun simctl spawn "$udid" log show --last "${minutes}m" --style compact --info --debug \
        --predicate 'subsystem BEGINSWITH "com.wiselfx.paseoclient"' 2>/dev/null \
        | tail -20000 >"$ART/$run/app.log" || true

    # Attachments (screenshots, text dumps) out of the result bundle, with shell-safe names.
    if [[ -d "$ART/$run/result.xcresult" ]]; then
        xcrun xcresulttool export attachments --path "$ART/$run/result.xcresult" \
            --output-path "$ART/$run/attachments" >/dev/null 2>&1 || true
        if [[ -d "$ART/$run/attachments" ]]; then
            find "$ART/$run/attachments" -type f | while IFS= read -r f; do
                base="$(basename "$f")"
                safe="$(printf '%s' "$base" | tr -c 'A-Za-z0-9._-' '_')"
                [[ "$base" == "$safe" ]] || mv "$f" "$(dirname "$f")/$safe"
            done
        fi
        rm -rf "$ART/$run/result.xcresult"
    fi

    grep -E '(error|warning): ' "$out" | grep -v 'warning: ' | sed "s#$REPO/##g" | sort -u | head -150 || true
    grep -E "^Test Case .* (passed|failed)" "$out" | sed -E "s/^Test Case '-\[[A-Za-z0-9_.]+ ([A-Za-z0-9_]+)\]' /\1 /" || true
    if [[ $status -eq 142 ]]; then
        echo "UITEST TIMED OUT after ${UITEST_MAX_SECONDS}s"
    elif [[ $status -ne 0 ]] && ! grep -qE "^Test Case .* failed" "$out"; then
        tail -40 "$out" | sed "s#$REPO/##g"
    fi
    grep -E '\*\* TEST (SUCCEEDED|FAILED|EXECUTE SUCCEEDED|EXECUTE FAILED) \*\*' "$out" || echo "TEST exit $status"
    echo "run $run"
    (cd "$ART" && find "$run" -type f | sort | head -400)
    # Keep the newest five runs.
    ls -1t "$ART" | tail -n +6 | while IFS= read -r old; do rm -rf "${ART:?}/$old"; done
    exit "$status"
    ;;
analyze)
    checkout_ref "${ref:-}"
    out="$(mktemp)"
    trap 'rm -f "$out"; rm -rf "$LOCKDIR"' EXIT
    set +e
    perl -e 'alarm shift; exec @ARGV' "$MAX_SECONDS" \
        xcodebuild -project App/PaseoClient.xcodeproj -scheme PaseoClient \
        -configuration Debug -destination 'generic/platform=iOS Simulator' \
        -derivedDataPath "$HOME/build-derived-data-analyze" \
        -skipPackagePluginValidation -skipMacroValidation \
        CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY="" \
        analyze >"$out" 2>&1
    status=$?
    set -e
    echo "$(date -u +%FT%TZ) analyze $ref status=$status" >>"$LOG"
    grep -E '(error|warning): ' "$out" | grep -E 'Paseo|analyzer|Logic error|Dead|leak|nil' | sed "s#$REPO/##g" | sort -u | head -200 || true
    grep -E '\*\* (ANALYZE|BUILD) (SUCCEEDED|FAILED) \*\*' "$out" || echo "ANALYZE exit $status"
    exit "$status"
    ;;
regen)
    checkout_ref "${ref:-}"
    command -v xcodegen >/dev/null || { echo "refused: xcodegen is not installed for this user (brew install xcodegen)" >&2; exit 2; }
    (cd App && xcodegen generate --quiet) 2>&1 | tail -20
    mkdir -p "$ART/regen"
    patch="$ART/regen/regen-$(date +%Y%m%d-%H%M%S)-$(git rev-parse --short HEAD).patch"
    git add -N App >/dev/null 2>&1 || true
    git diff --binary -- App >"$patch"
    git checkout --quiet --force -- . && git clean -fdq
    if [[ -s "$patch" ]]; then
        echo "project.yml changes the Xcode project: patch is ${patch#$ART/}"
        grep -c '^diff --git' "$patch" | sed 's/^/files changed: /'
    else
        rm -f "$patch"
        echo "the committed Xcode project already matches project.yml"
    fi
    ;;
install)
    checkout_ref "${ref:-}"
    require_sim
    out="$(mktemp)"
    trap 'rm -f "$out"; rm -rf "$LOCKDIR"' EXIT
    set +e
    perl -e 'alarm shift; exec @ARGV' "$MAX_SECONDS" \
        xcodebuild -project App/PaseoClient.xcodeproj -scheme PaseoClient \
        -configuration Debug -destination "platform=iOS Simulator,id=$udid" \
        -derivedDataPath "$DERIVED" -skipPackagePluginValidation -skipMacroValidation \
        CODE_SIGN_IDENTITY=- CODE_SIGNING_REQUIRED=NO build >"$out" 2>&1
    status=$?
    set -e
    if [[ $status -ne 0 ]]; then
        grep -E 'error: ' "$out" | sed "s#$REPO/##g" | sort -u | head -100 || true
        echo "INSTALL FAILED (build exit $status)"
        exit "$status"
    fi
    app="$(find "$DERIVED/Build/Products/Debug-iphonesimulator" -maxdepth 1 -name '*.app' | head -1)"
    xcrun simctl install "$udid" "$app"
    echo "installed $(git rev-parse --short HEAD) on $udid"
    ;;
launch)
    require_sim
    args=()
    if [[ -n "${ref:-}" && "$ref" != "-" ]]; then
        if [[ ! "$ref" =~ ^[A-Za-z0-9_.,=:/-]{1,300}$ ]]; then echo "refused: bad launch arguments" >&2; exit 2; fi
        IFS=',' read -r -a args <<<"$ref"
    fi
    xcrun simctl terminate "$udid" "$BUNDLE_ID" >/dev/null 2>&1 || true
    xcrun simctl launch "$udid" "$BUNDLE_ID" ${args[@]+"${args[@]}"}
    ;;
terminate)
    require_sim
    xcrun simctl terminate "$udid" "$BUNDLE_ID" || true
    ;;
shot)
    require_sim
    name="${ref:-shot}"
    if [[ ! "$name" =~ ^[A-Za-z0-9_-]{1,60}$ ]]; then echo "refused: bad name" >&2; exit 2; fi
    mkdir -p "$ART/shots"
    f="shots/$(date +%Y%m%d-%H%M%S)-$name.png"
    xcrun simctl io "$udid" screenshot --type=png "$ART/$f" >/dev/null 2>&1 || { require_sim; xcrun simctl io "$udid" screenshot --type=png "$ART/$f" >/dev/null; }
    ls -1t "$ART/shots" | tail -n +31 | while IFS= read -r old; do rm -f "${ART:?}/shots/$old"; done
    echo "$f"
    ;;
openurl)
    require_sim
    if [[ ! "${ref:-}" =~ ^paseo://[A-Za-z0-9._~:/?#@!$\&\'*+,\;=%-]{0,500}$ ]]; then
        echo "refused: only paseo:// URLs" >&2
        exit 2
    fi
    xcrun simctl openurl "$udid" "$ref"
    ;;
appearance)
    require_sim
    case "${ref:-}" in light|dark) xcrun simctl ui "$udid" appearance "$ref" ;; *) echo "refused: light or dark" >&2; exit 2 ;; esac
    ;;
textsize)
    require_sim
    case "${ref:-}" in
        xs) c=extra-small ;; s) c=small ;; m) c=medium ;; l) c=large ;; xl) c=extra-large ;;
        xxl) c=extra-extra-large ;; xxxl) c=extra-extra-extra-large ;;
        ax1) c=accessibility-medium ;; ax2) c=accessibility-large ;; ax3) c=accessibility-extra-large ;;
        ax4) c=accessibility-extra-extra-large ;; ax5) c=accessibility-extra-extra-extra-large ;;
        *) echo "refused: xs s m l xl xxl xxxl ax1..ax5" >&2; exit 2 ;;
    esac
    xcrun simctl ui "$udid" content_size "$c"
    ;;
statusbar)
    require_sim
    case "${ref:-}" in
        on) xcrun simctl status_bar "$udid" override --time 9:41 --batteryState charged --batteryLevel 100 --cellularBars 4 --wifiBars 3 ;;
        off) xcrun simctl status_bar "$udid" clear ;;
        *) echo "refused: on or off" >&2; exit 2 ;;
    esac
    ;;
privacy)
    require_sim
    case "${ref:-}" in grant|revoke|reset) ;; *) echo "refused: grant, revoke or reset" >&2; exit 2 ;; esac
    case "${arg2:-}" in photos|camera|microphone|location|contacts|calendar) ;; *) echo "refused: photos camera microphone location contacts calendar" >&2; exit 2 ;; esac
    xcrun simctl privacy "$udid" "$ref" "$arg2" "$BUNDLE_ID"
    ;;
crashes)
    n="${ref:-1}"
    if [[ ! "$n" =~ ^[1-3]$ ]]; then echo "refused: 1 to 3" >&2; exit 2; fi
    dir="$HOME/Library/Logs/DiagnosticReports"
    ls -1t "$dir"/Paseo*.ips "$dir"/Paseo*.crash 2>/dev/null | head -n "$n" | while IFS= read -r f; do
        echo "== $(basename "$f")"
        head -c 40000 "$f" | head -400
    done
    ;;
status)
    echo "gate v$GATE_VERSION"
    df -h "$HOME" | tail -1
    echo "lock: $(cat "$LOCKDIR/pid" 2>/dev/null || echo free)"
    udid="$(pick_sim || true)"
    echo "simulator: ${udid:-none} $(xcrun simctl list devices | grep -F "$udid" | head -1 | grep -oE '\((Booted|Shutdown)\)' || true)"
    if [[ -n "$udid" ]]; then
        xcrun simctl get_app_container "$udid" "$BUNDLE_ID" >/dev/null 2>&1 && echo "app: installed" || echo "app: not installed"
    fi
    echo "memory (this user's processes by resident size, MB):"
    ps -u "$(id -u)" -o pid=,rss=,etime=,comm= -r 2>/dev/null | head -12 \
        | awk '{printf "%7d  %6.0f MB  %10s  %s\n", $1, $2/1024, $3, $4}' || true
    echo "mac memory: $(memory_pressure 2>/dev/null | grep -i 'free percentage' || true)"
    echo "recent gate log:"; tail -8 "$LOG" 2>/dev/null || true
    du -sh "$DERIVED" "$ART" 2>/dev/null || true
    ;;
kill|killbuilds)
    me="$(id -u)"
    # Names that may be stopped: build and simulator tooling and the app itself. Never the shell,
    # sshd, launchd or anything else.
    stoppable() {
        case "$(basename "$1")" in
            xcodebuild|XCBBuildService|SWBBuildService|swift-build|swift-frontend|swift-driver|swift-package|swift|swiftc|clang|clang-*|ld|libtool|actool|ibtool|xcrun|xcodegen|xctest|xctrace|testmanagerd|Simulator|launchd_sim|CoreSimulatorService|com.apple.CoreSimulator.*|Paseo|PaseoClient|PaseoUITests-Runner|PaseoUITests|*-Runner) return 0 ;;
            *) return 1 ;;
        esac
    }
    # This gate run and its parents are never killed.
    protect=" $$ $PPID "
    pp="$PPID"
    for _ in 1 2 3 4 5 6; do
        pp="$(ps -p "$pp" -o ppid= 2>/dev/null | tr -d ' ' || true)"
        [[ -n "$pp" && "$pp" != 0 ]] && protect="$protect$pp " || break
    done
    stop_one() {
        local pid="$1" owner comm
        [[ "$protect" == *" $pid "* ]] && return 1
        read -r owner comm < <(ps -p "$pid" -o uid=,comm= 2>/dev/null) || return 1
        [[ "$owner" == "$me" ]] || { echo "refused: $pid is not this user's process" >&2; return 1; }
        stoppable "$comm" || { echo "refused: $pid ($(basename "$comm")) is not a build or simulator tool" >&2; return 1; }
        kill -TERM "$pid" 2>/dev/null || return 1
        for _ in 1 2 3; do sleep 1; kill -0 "$pid" 2>/dev/null || { echo "stopped $pid $(basename "$comm")"; return 0; }; done
        kill -KILL "$pid" 2>/dev/null || true
        echo "killed $pid $(basename "$comm")"
    }
    if [[ "$verb" == "kill" ]]; then
        if [[ ! "${ref:-}" =~ ^[0-9]{2,9}$ ]]; then echo "refused: a numeric pid" >&2; exit 2; fi
        stop_one "$ref" || exit 2
    else
        count=0
        while read -r pid comm; do
            if stoppable "$comm" && stop_one "$pid" >/dev/null 2>&1; then count=$((count + 1)); echo "stopped $pid $(basename "$comm")"; fi
        done < <(ps -u "$me" -o pid=,comm= 2>/dev/null)
        echo "stopped $count process(es)"
    fi
    ;;
clean)
    rm -rf "${HOME:?}/build-derived-data" "${HOME:?}/build-derived-data-device" "${HOME:?}/build-derived-data-analyze" "${ART:?}"
    echo "cleaned derived data and artifacts"
    ;;
ls)
    mkdir -p "$ART"
    if [[ -z "${ref:-}" ]]; then
        ls -1t "$ART"
    elif [[ "$ref" =~ ^[A-Za-z0-9._-]{1,80}$ ]] && [[ "$ref" != .* ]] && [[ -d "$ART/$ref" ]]; then
        (cd "$ART" && find "$ref" -type f | sort | head -400)
    else
        echo "refused: unknown run" >&2
        exit 2
    fi
    ;;
get)
    if [[ ! "${ref:-}" =~ ^[A-Za-z0-9._/-]{1,300}$ ]] || [[ "$ref" == *..* ]] || [[ "$ref" == /* ]] || [[ "$ref" == -* ]]; then
        echo "refused: bad path" >&2
        exit 2
    fi
    if [[ ! -f "$ART/$ref" ]] || [[ -L "$ART/$ref" ]]; then
        echo "refused: no such artifact" >&2
        exit 2
    fi
    cat "$ART/$ref"
    ;;
*)
    echo "refused: unknown verb (see the header of build-gate for the list)" >&2
    exit 2
    ;;
esac
